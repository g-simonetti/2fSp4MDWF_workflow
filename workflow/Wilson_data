WILSON_ANALYSIS_DATA_DIR = "external_data/wilson_fermions_data/"
WILSON_ANALYSIS_DATA_MARKER = f"{WILSON_ANALYSIS_DATA_DIR}PREPARED"
WILSON_UPSTREAM_INPUTS_MARKER = "external_data/wilson_upstream/UPSTREAM_INPUTS_PREPARED"

WILSON_PRECOMPUTED_DATA_ARCHIVE = "external_data/wilson_upstream/wilson_fermions_data.tar"
WILSON_LOCAL_PRECOMPUTED_DATA_ARCHIVE = ""
WILSON_PRECOMPUTED_DATA_URL = ""
WILSON_PRECOMPUTED_DATA_MD5 = ""
WILSON_PRECOMPUTED_DATA_SOURCE_SUBDIR = "wilson_fermions_data"

WILSON_WORKFLOW_DIR = "external_data/wilson_upstream/fundamental_Wilson_fermion_analysis_2026"
WILSON_WORKFLOW_ARCHIVE = "external_data/wilson_upstream/fundamental_Wilson_fermion_analysis_2026.zip"
WILSON_WORKFLOW_URL = "https://zenodo.org/api/records/20638262/files/fundamental_Wilson_fermion_analysis_2026.zip/content"
WILSON_WORKFLOW_MD5 = "3bfb1388a10b1f1d9074546142cd9acf"

WILSON_RAW_DATA_ARCHIVE = "external_data/wilson_upstream/raw_data.tar"
WILSON_LOCAL_RAW_DATA_ARCHIVE = ""
WILSON_RAW_DATA_URL = "https://zenodo.org/api/records/20111459/files/raw_data.tar/content"
WILSON_RAW_DATA_MD5 = "b8d4b2dcaca26473b51229d3e9d71dfc"
WILSON_RAW_DATA_DIR = ""

WILSON_METADATA_ARCHIVE = "external_data/wilson_upstream/metadata.tar"
WILSON_METADATA_URL = "https://zenodo.org/api/records/20111459/files/metadata.tar/content"
WILSON_METADATA_MD5 = "deec45d218f1147faf3222c404a57d60"

WILSON_UPSTREAM_TARGET = "required_wilson_jsons"
WILSON_JULIA_READY = f"{WILSON_WORKFLOW_DIR}/intermediary_data/julia_ready"


rule prepare_wilson_upstream_inputs:
    priority: 100
    output:
        marker = touch(WILSON_UPSTREAM_INPUTS_MARKER)
    params:
        output_dir = WILSON_ANALYSIS_DATA_DIR,
        marker = WILSON_UPSTREAM_INPUTS_MARKER,
        mode = "auto",
        precomputed_data_archive = WILSON_PRECOMPUTED_DATA_ARCHIVE,
        local_precomputed_data_archive = WILSON_LOCAL_PRECOMPUTED_DATA_ARCHIVE,
        precomputed_data_url = WILSON_PRECOMPUTED_DATA_URL,
        precomputed_data_md5 = WILSON_PRECOMPUTED_DATA_MD5,
        precomputed_data_source_subdir = WILSON_PRECOMPUTED_DATA_SOURCE_SUBDIR,
        workflow_dir = WILSON_WORKFLOW_DIR,
        workflow_archive = WILSON_WORKFLOW_ARCHIVE,
        workflow_url = WILSON_WORKFLOW_URL,
        workflow_md5 = WILSON_WORKFLOW_MD5,
        raw_data_archive = WILSON_RAW_DATA_ARCHIVE,
        local_raw_data_archive = WILSON_LOCAL_RAW_DATA_ARCHIVE,
        raw_data_url = WILSON_RAW_DATA_URL,
        raw_data_md5 = WILSON_RAW_DATA_MD5,
        raw_data_dir = WILSON_RAW_DATA_DIR,
        metadata_archive = WILSON_METADATA_ARCHIVE,
        metadata_url = WILSON_METADATA_URL,
        metadata_md5 = WILSON_METADATA_MD5,
        upstream_target = WILSON_UPSTREAM_TARGET
    threads: 1
    shell:
        "python3 src/data/prepare_wilson_analysis_data.py "
        "--mode '{params.mode}' "
        "--output-dir '{params.output_dir}' "
        "--marker '{output.marker}' "
        "--precomputed-data-archive '{params.precomputed_data_archive}' "
        "--local-precomputed-data-archive '{params.local_precomputed_data_archive}' "
        "--precomputed-data-url '{params.precomputed_data_url}' "
        "--precomputed-data-md5 '{params.precomputed_data_md5}' "
        "--precomputed-data-source-subdir '{params.precomputed_data_source_subdir}' "
        "--workflow-dir '{params.workflow_dir}' "
        "--workflow-archive '{params.workflow_archive}' "
        "--workflow-url '{params.workflow_url}' "
        "--workflow-md5 '{params.workflow_md5}' "
        "--raw-data-archive '{params.raw_data_archive}' "
        "--local-raw-data-archive '{params.local_raw_data_archive}' "
        "--raw-data-url '{params.raw_data_url}' "
        "--raw-data-md5 '{params.raw_data_md5}' "
        "--raw-data-dir '{params.raw_data_dir}' "
        "--metadata-archive '{params.metadata_archive}' "
        "--metadata-url '{params.metadata_url}' "
        "--metadata-md5 '{params.metadata_md5}' "
        "--upstream-target '{params.upstream_target}' "
        "--prepare-upstream-inputs-only "
        "--cores {threads}"


rule prepare_wilson_julia_environment:
    priority: 90
    input:
        upstream_inputs = WILSON_UPSTREAM_INPUTS_MARKER
    output:
        julia_ready = WILSON_JULIA_READY
    params:
        output_dir = WILSON_ANALYSIS_DATA_DIR,
        workflow_dir = WILSON_WORKFLOW_DIR,
        upstream_target = WILSON_UPSTREAM_TARGET
    threads: 1
    shell:
        "python3 -c \""
        "import sys; "
        "from pathlib import Path; "
        "sys.path.insert(0, 'src/data'); "
        "from prepare_wilson_analysis_data import analysis_data_ready, upstream_targets; "
        "output_dir = Path(r'{params.output_dir}'); "
        "sys.exit(0) if analysis_data_ready(output_dir) else None; "
        "workflow_dir = Path(r'{params.workflow_dir}'); "
        "targets = upstream_targets(workflow_dir, r'{params.upstream_target}'); "
        "sys.exit(0 if targets and all((workflow_dir / target).exists() for target in targets) else 1)"
        "\" "
        "&& touch '{output.julia_ready}' "
        "|| (cd '{params.workflow_dir}' && "
        "snakemake --cores {threads} --use-conda intermediary_data/julia_ready)"


rule prepare_wilson_analysis_data:
    priority: 50
    input:
        upstream_inputs = WILSON_UPSTREAM_INPUTS_MARKER,
        julia_ready = WILSON_JULIA_READY
    output:
        marker = touch(WILSON_ANALYSIS_DATA_MARKER)
    params:
        output_dir = WILSON_ANALYSIS_DATA_DIR,
        marker = WILSON_ANALYSIS_DATA_MARKER,
        mode = "auto",
        precomputed_data_archive = WILSON_PRECOMPUTED_DATA_ARCHIVE,
        local_precomputed_data_archive = WILSON_LOCAL_PRECOMPUTED_DATA_ARCHIVE,
        precomputed_data_url = WILSON_PRECOMPUTED_DATA_URL,
        precomputed_data_md5 = WILSON_PRECOMPUTED_DATA_MD5,
        precomputed_data_source_subdir = WILSON_PRECOMPUTED_DATA_SOURCE_SUBDIR,
        workflow_dir = WILSON_WORKFLOW_DIR,
        workflow_archive = WILSON_WORKFLOW_ARCHIVE,
        workflow_url = WILSON_WORKFLOW_URL,
        workflow_md5 = WILSON_WORKFLOW_MD5,
        raw_data_archive = WILSON_RAW_DATA_ARCHIVE,
        local_raw_data_archive = WILSON_LOCAL_RAW_DATA_ARCHIVE,
        raw_data_url = WILSON_RAW_DATA_URL,
        raw_data_md5 = WILSON_RAW_DATA_MD5,
        raw_data_dir = WILSON_RAW_DATA_DIR,
        metadata_archive = WILSON_METADATA_ARCHIVE,
        metadata_url = WILSON_METADATA_URL,
        metadata_md5 = WILSON_METADATA_MD5,
        upstream_target = WILSON_UPSTREAM_TARGET
    threads: workflow.cores
    shell:
        "python3 src/data/prepare_wilson_analysis_data.py "
        "--mode '{params.mode}' "
        "--output-dir '{params.output_dir}' "
        "--marker '{output.marker}' "
        "--precomputed-data-archive '{params.precomputed_data_archive}' "
        "--local-precomputed-data-archive '{params.local_precomputed_data_archive}' "
        "--precomputed-data-url '{params.precomputed_data_url}' "
        "--precomputed-data-md5 '{params.precomputed_data_md5}' "
        "--precomputed-data-source-subdir '{params.precomputed_data_source_subdir}' "
        "--workflow-dir '{params.workflow_dir}' "
        "--workflow-archive '{params.workflow_archive}' "
        "--workflow-url '{params.workflow_url}' "
        "--workflow-md5 '{params.workflow_md5}' "
        "--raw-data-archive '{params.raw_data_archive}' "
        "--local-raw-data-archive '{params.local_raw_data_archive}' "
        "--raw-data-url '{params.raw_data_url}' "
        "--raw-data-md5 '{params.raw_data_md5}' "
        "--raw-data-dir '{params.raw_data_dir}' "
        "--metadata-archive '{params.metadata_archive}' "
        "--metadata-url '{params.metadata_url}' "
        "--metadata-md5 '{params.metadata_md5}' "
        "--upstream-target '{params.upstream_target}' "
        "--upstream-julia-ready '{input.julia_ready}' "
        "--cores {threads}"
