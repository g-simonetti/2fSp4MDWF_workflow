            "assets/plots/finite_volume/finite_volume_plot_B{beta}M{mass}",
            config["plot_filetype"],
        )
    conda:
        "envs/analysis.yml"
    shell:
        (
            "python src/finite_volume/finite_volume_exp.py "
            "--label {config[label]} "
            "--m_ps {input.m_ps} "
            "--metadata_csv {input.metadata_csv} "
            "--use finite_volume "
            "--fv_out {output.fv_out} "
            "--fv_plot {output.fv_plot} "
            "--plot_styles {config[plot_styles]} "
            "--beta {wildcards.beta} "
            "--mass {wildcards.mass} "
        )


