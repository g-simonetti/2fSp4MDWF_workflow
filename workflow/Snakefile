        mres=(
            "intermediary_data/NF{NF}/Nt{Nt}/Ns{Ns}/Ls{Ls}/"
            "B{beta}/M{mass}/mpv{mpv}/alpha{alpha}/a5{a5}/M5{M5}/"
            "residual_mass/mres_t.pdf"
        )
    output:
        mres_cp=(
            "assets/plots/bulk_phase/"
            "mres_NF{NF}_B{beta}M{mass}_Nt{Nt}Ns{Ns}Ls{Ls}_mpv{mpv}alpha{alpha}a5{a5}M5{M5}.pdf"
        )
    shell:
        r"""
        cp "{input.mres}" "{output.mres_cp}"
        """

