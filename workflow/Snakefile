# -------------------------------------------------#
# CSV files
# -------------------------------------------------#
# 1) Single ensembles: mres, mps, mv, w0, fps, Z
# 2) finite volume
# 3) spectrum                           
# -------------------------------------------------#


rule single_ensembles:
    input:
        metadata = "metadata/ensembles.csv",

        plaq_YM = lambda wc: load_and_expand(
            wc,
            "intermediary_data/NF{NF}/Nt{Nt}/Ns{Ns}/B{beta}/"
            "hmc/log_hmc_extract.json",
            flag="use_in_YM",
        ),

        plaq_NF = lambda wc: load_and_expand(
            wc,
            "intermediary_data/NF{NF}/Nt{Nt}/Ns{Ns}/Ls{Ls}/"
            "B{beta}/M{mass}/mpv{mpv}/alpha{alpha}/a5{a5}/M5{M5}/"
            "hmc/log_hmc_extract.json",
            flag=["use_in_bulkphase_mres",
                  "use_in_scan_param",
                  "use_in_scan_Ls",
                  "use_in_bulkphase_tuned",
                  "use_in_bulkphase_Shamir",
                  "use_in_finite_volume"
                  ],
        ),


        mres = lambda wc: load_and_expand(
            wc,
            "intermediary_data/NF{NF}/Nt{Nt}/Ns{Ns}/Ls{Ls}/"
            "B{beta}/M{mass}/mpv{mpv}/alpha{alpha}/a5{a5}/M5{M5}/"
            "residual_mass/m_res.json",
            flag = ["use_in_bulkphase_mres",
                    "use_in_scan_param",
                    "use_in_scan_Ls",
                    "use_in_finite_volume",
                    "use_in_spectrum"],
        ),

        spectrum = lambda wc: load_and_expand(
            wc,
            "intermediary_data/NF{NF}/Nt{Nt}/Ns{Ns}/Ls{Ls}/"
            "B{beta}/M{mass}/mpv{mpv}/alpha{alpha}/a5{a5}/M5{M5}/"
            "spectrum/spectrum.json",
            flag=["use_in_finite_volume", "use_in_spectrum"]
        ),

        wflow = lambda wc: load_and_expand(
            wc,
            "intermediary_data/NF{NF}/Nt{Nt}/Ns{Ns}/Ls{Ls}/"
            "B{beta}/M{mass}/mpv{mpv}/alpha{alpha}/a5{a5}/M5{M5}/"
            "wflow/wflow_extract.json",
            flag="use_in_spectrum",
        ),
             
    output:
        csv = "metadata/output/single_ensembles.csv"
    conda:
        "envs/analysis.yml"
    shell:
        "python src/csv/single_ensembles.py "
        "--input_file {input.metadata} "
        "--mres {input.mres} "
        "--spectrum {input.spectrum} "
        "--wflow {input.wflow} "
        "--plaq_YM {input.plaq_YM} "
        "--plaq_NF {input.plaq_NF} "
        "--output_file {output.csv}"
