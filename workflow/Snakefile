###############
## Snakefile ##
###############

import pandas
from snakemake.io import multiext, expand

configfile: "config/config.yaml"


# -------------------------------------------------#
# Load ensembles CSV 
# -------------------------------------------------#

ENSEMBLES_DF = pandas.read_csv(
    "metadata/ensembles.csv",
    sep=r"\t|,",
    engine="python",
).convert_dtypes()


# -------------------------------------------------#
# Helpers                                           
# -------------------------------------------------#

def resolve_flag(wc, flag=None):
    """
    Default selection column is: use_in_{use}.
    """
    if flag is None:
        # Use .get to avoid error if rule doesn't have {use} wildcard
        use_val = getattr(wc, "use", "default") 
        return f"use_in_{use_val}"
    
    # Safely format the flag string with wildcards
    try:
        return flag.format(**wc)
    except KeyError:
        return flag



def load_and_expand(wc, pattern, flag=None):
    df = ENSEMBLES_DF.copy()

    # Allow either:
    # - no explicit flag  -> use the default "use_in_{use}"
    # - one flag string   -> e.g. "use_in_spectrum"
    # - many flag strings -> e.g. ["use_in_scan_param", "use_in_scan_Ls"]
    if flag is None:
        flagcols = [resolve_flag(wc, None)]
    elif isinstance(flag, (list, tuple, set)):
        flagcols = [resolve_flag(wc, f) for f in flag]
    else:
        flagcols = [resolve_flag(wc, flag)]

    # Check that every requested flag column actually exists in ensembles.csv
    for col in flagcols:
        if col not in df.columns:
            raise ValueError(f"Column '{col}' not found in metadata/ensembles.csv")

    # Keep rows where ANY of the requested flags is True
    # This gives an OR condition across multiple flag columns
    mask = False
    for col in flagcols:
        mask = mask | (df[col] == True)

    df = df[mask]

    # If the calling rule has beta/mass wildcards, restrict to matching rows
    # This is useful for rules like finite-volume plots at fixed beta and mass
    if hasattr(wc, "beta"):
        df = df[df["beta"].astype(str) == str(wc.beta)]

    if hasattr(wc, "mass"):
        df = df[df["mass"].astype(str) == str(wc.mass)]

    # Stop early if no ensembles match the flag selection / wildcards
    if df.empty:
        raise ValueError(
            f"No ensembles found for flags={flagcols}, "
            f"beta={getattr(wc, 'beta', None)}, "
            f"mass={getattr(wc, 'mass', None)}"
        )

    out = []
    use_subdir = "{subdir}" in pattern

    # Build the list of file paths by filling the pattern with values
    # from each selected metadata row
    for _, row in df.iterrows():
        NF = int(row["NF"])
        Nt = int(row["Nt"])
        Ns = int(row["Ns"])
        beta = row["beta"]

        if use_subdir:
            # Some rules use a compressed "{subdir}" path layout
            if NF == 0:
                subdir = f"B{beta}"
            else:
                subdir = (
                    f"Ls{int(row['Ls'])}/"
                    f"B{beta}/"
                    f"M{row['mass']}/"
                    f"mpv{row['mpv']}/"
                    f"alpha{row['alpha']}/"
                    f"a5{row['a5']}/"
                    f"M5{row['M5']}"
                )

            out.extend(
                expand(
                    pattern,
                    NF=NF,
                    Nt=Nt,
                    Ns=Ns,
                    subdir=subdir,
                )
            )

        else:
            # Standard path layout
            if NF == 0:
                # Pure Yang-Mills ensembles have a shorter directory structure
                out.extend(
                    expand(
                        pattern,
                        NF=0,
                        Nt=Nt,
                        Ns=Ns,
                        beta=beta,
                    )
                )
            else:
                # Dynamical ensembles use the full set of parameters
                out.extend(
                    expand(
                        pattern,
                        NF=NF,
                        Nt=Nt,
                        Ns=Ns,
                        Ls=int(row["Ls"]),
                        beta=row["beta"],
                        mass=row["mass"],
                        mpv=row["mpv"],
                        alpha=row["alpha"],
                        a5=row["a5"],
                        M5=row["M5"],
                    )
                )

    # Remove duplicates in case one ensemble matched more than one flag
    return sorted(set(out))


def find_query(wc):
    # YM ensembles (no NF, Ls, etc.)
    if not hasattr(wc, "NF"):
        return (
            "YM == 'yes' "
            f"and Nt == {wc.Nt} "
            f"and Ns == {wc.Ns} "
            f"and beta == {wc.beta}"
        )

    # Mobius/Shamir ensembles
    return (
        f"NF == {wc.NF} "
        f"and Nt == {wc.Nt} "
        f"and Ns == {wc.Ns} "
        f"and Ls == {wc.Ls} "
        f"and beta == {wc.beta} "
        f"and mass == {wc.mass} "
        f"and alpha == {wc.alpha} "
        f"and a5 == {wc.a5} "
        f"and M5 == {wc.M5} "
        f"and mpv == {wc.mpv}"
    )


def lookup(within, query, cols):
    df = within.query(query)
    if len(df) != 1:
        raise ValueError(f"lookup expected 1 row, got {len(df)} for query: {query}")
    return df.iloc[0][cols]


def metadata_lookup(variable_name):
    def metadata_lookup_inner(wildcards):
        val = lookup(ENSEMBLES_DF, find_query(wildcards), variable_name)
        # Check if the value is a Pandas <NA>, None, or NaN
        if pandas.isna(val):
            return -1  # Or whatever default your src/spectrum/spectrum.py expects for "auto"
        return val

    return metadata_lookup_inner


