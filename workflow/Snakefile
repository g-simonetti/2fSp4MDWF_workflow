# -------------------------------------------------#
# Residual mass rules
# -------------------------------------------------#
# 1) Extracts the residual mass series and
#    a correlated fitted value
# 2) Plots the residual mass as a function of 
#    the unphysical parameters. Using scan_beta
#    it plots the residual mass series 
#    as a function of t/a for two volumes and
#    different betas and masses
# 3) Plots the residual mass as a function of Ls 
#    and perform the fits           
# 4) Generate the computational costs comparison
#    plots                          
# -------------------------------------------------#


rule m_res:
    input:
        "raw_data/NF{NF}/Nt{Nt}/Ns{Ns}/Ls{Ls}/"
        "B{beta}/M{mass}/mpv{mpv}/alpha{alpha}/a5{a5}/M5{M5}/"
        "mesons"
    output:
        mres_out =
            "intermediary_data/NF{NF}/Nt{Nt}/Ns{Ns}/Ls{Ls}/"
            "B{beta}/M{mass}/mpv{mpv}/alpha{alpha}/a5{a5}/M5{M5}/"
            "residual_mass/m_res.json",
        plot = multiext(
            "intermediary_data/NF{NF}/Nt{Nt}/Ns{Ns}/Ls{Ls}/"
            "B{beta}/M{mass}/mpv{mpv}/alpha{alpha}/a5{a5}/M5{M5}/"
            "residual_mass/mres_t",
            config["plot_filetype"],
        )
    params:
        plateau_start = metadata_lookup("mres_p_start"),
        plateau_end   = metadata_lookup("mres_p_end"),
        therm         = metadata_lookup("therm"),
        delta_traj_conf = metadata_lookup("delta_traj_conf"),
    conda:
        "envs/analysis.yml"
    shell:
        (
            "python src/residual_mass/residual_mass_fit.py {input} "
            "--label {config[label]} "
            "--mres_out {output.mres_out} "
            "--plot_file {output.plot} "
            "--plot_styles {config[plot_styles]} "
            "--plateau_start {params.plateau_start} "
            "--plateau_end {params.plateau_end} "
            "--therm {params.therm} "
            "--delta_traj_conf {params.delta_traj_conf} "
            "--Nt {wildcards.Nt} "
	    "--Ns {wildcards.Ns} "
            "--Ls {wildcards.Ls} "
            "--beta {wildcards.beta} "
            "--mass {wildcards.mass} "
            "--alpha {wildcards.alpha} "
            "--a5 {wildcards.a5} "
            "--m5 {wildcards.M5} "
            "--mpv {wildcards.mpv}"
        )



rule plot_mres_scan:
    input:
        mres = lambda wc: load_and_expand(
            wc,
            "intermediary_data/NF{NF}/Nt{Nt}/Ns{Ns}/Ls{Ls}/"
            "B{beta}/M{mass}/mpv{mpv}/alpha{alpha}/a5{a5}/M5{M5}/"
            "residual_mass/m_res.json",
            flag = "use_in_scan_param",
        ),
    output:
        "assets/plots/parameter_scan/mres_scan_param_b{beta}.pdf"
    conda:
        "envs/analysis.yml"
    shell:
        "python src/parameter_scan/plot_mres_scan.py "
        "--use scan_param "
        "--mres {input.mres} "
        "--output_filename {output} "
        "--label {config[label]} "
        "--plot_styles {config[plot_styles]}"


rule fit_mres_scan_Ls:
    input:
        mres=lambda wc: load_and_expand(
            wc,
            "intermediary_data/NF{NF}/Nt{Nt}/Ns{Ns}/Ls{Ls}/"
            "B{beta}/M{mass}/mpv{mpv}/alpha{alpha}/a5{a5}/M5{M5}/"
            "residual_mass/m_res.json"
        ),
    output:
        ls_scan="assets/plots/parameter_scan/Shamir_vs_Mobius_mres_{use}.pdf",
        fit_json="intermediary_data/NF2/parameter_scan/Shamir_vs_Mobius_mres_fits_{use}.json",
    conda:
        "envs/analysis.yml"
    shell:
        "python src/parameter_scan/fit_mres_scan_Ls.py "
        "--mres {input.mres} "
        "--label {config[label]} "
        "--ls_scan {output.ls_scan} "
        "--fit_json {output.fit_json} "
        "--plot_styles {config[plot_styles]}"




rule plot_cost_Ls_from_fit:
    input:
        fit_json="intermediary_data/NF2/parameter_scan/Shamir_vs_Mobius_mres_fits_{use}.json",
        hmc=lambda wc: load_and_expand(
            wc,
            "intermediary_data/NF{NF}/Nt{Nt}/Ns{Ns}/Ls{Ls}/"
            "B{beta}/M{mass}/mpv{mpv}/alpha{alpha}/a5{a5}/M5{M5}/"
            "hmc/log_hmc_extract.json"
        ),
    output:
        costs="assets/plots/parameter_scan/Shamir_vs_Mobius_costs_mres_{use}.pdf",
    params:
        machine="sunbird",
        tau_flag="--plaq",
    conda:
        "envs/analysis.yml"
    shell:
        "python src/parameter_scan/plot_cost_scan_from_fit_json.py "
        "--fit_json {input.fit_json} "
        "--hmc {input.hmc} "
        "{params.tau_flag} "
        "--label {config[label]} "
        "--machine {params.machine} "
        "--costs {output.costs} "
        "--plot_styles {config[plot_styles]}"



# -------------------------------------------------#
# Log files analysis rules
# -------------------------------------------------#
# 1) Extract the average plaquette and its
#    integrated autocorrelation time                                      
# -------------------------------------------------#


rule log_process:
    input:
        "raw_data/NF{NF}/Nt{Nt}/Ns{Ns}/{subdir}/log"
    output:
        hmc_out="intermediary_data/NF{NF}/Nt{Nt}/Ns{Ns}/{subdir}/hmc/log_hmc_extract.json",
    conda:
        "envs/analysis.yml"
    shell:
        (
            "python src/hmc/log_ensembles_extract.py {input} "
            "--ensembles_csv metadata/ensembles.csv "
            "--plot_styles '{config[plot_styles]}' "
            "--hmc_out {output.hmc_out}"
        )


# -------------------------------------------------#
# Bulk phase study
# -------------------------------------------------#
# 1) Plots the average plaquette for tuned Mobius
#    action as a function of the bare masses and 
#    their HMC-time evolution.
#    Plots the average plaquette for Shamir 
#    action as a function of beta and the bare
#    masses. Pure YM data and residual mass
#    data are also shown                              
# -------------------------------------------------#


rule bulk_phase:
    input:
        ensembles_csv="metadata/ensembles.csv",

        # tuned Möbius
        tuned_avg=lambda wc: load_and_expand(
            wc,
            "intermediary_data/NF{NF}/Nt{Nt}/Ns{Ns}/Ls{Ls}/"
            "B{beta}/M{mass}/mpv{mpv}/alpha{alpha}/a5{a5}/M5{M5}/"
            "hmc/log_hmc_extract.json",
            flag="use_in_bulkphase_tuned",
        ),

        # Shamir bulk phase
        shamir_avg=lambda wc: load_and_expand(
            wc,
            "intermediary_data/NF{NF}/Nt{Nt}/Ns{Ns}/Ls{Ls}/"
            "B{beta}/M{mass}/mpv{mpv}/alpha{alpha}/a5{a5}/M5{M5}/"
            "hmc/log_hmc_extract.json",
            flag="use_in_bulkphase_Shamir",
        ),

        # YM references (NF0)
        ym_avg=lambda wc: load_and_expand(
            wc,
            "intermediary_data/NF{NF}/Nt{Nt}/Ns{Ns}/B{beta}/"
            "hmc/log_hmc_extract.json",
            flag="use_in_YM",
        ),

        # mres Shamir
        mres_shamir=lambda wc: load_and_expand(
            wc,
            "intermediary_data/NF{NF}/Nt{Nt}/Ns{Ns}/Ls{Ls}/"
            "B{beta}/M{mass}/mpv{mpv}/alpha{alpha}/a5{a5}/M5{M5}/"
            "residual_mass/m_res.json",
            flag="use_in_bulkphase_mres",
        ),
    output:
        tuned_masses="assets/plots/bulk_phase/mobius_tuned_plaq_vs_mass.pdf",
        tuned_history="assets/plots/bulk_phase/mobius_tuned_plaq_history.pdf",
        shamir_summary="assets/plots/bulk_phase/plaq_mass_beta_shamir.pdf",
    conda:
        "envs/analysis.yml"
    shell:
        (
            "python src/bulk_phase/bulk_phase.py "
            "--ensembles_csv {input.ensembles_csv} "
            "--plaq_avg {input.tuned_avg} {input.shamir_avg} {input.ym_avg} "
            "--mres_data {input.mres_shamir} "
            "--label {config[label]} "
            "--plot_styles '{config[plot_styles]}' "
            "--tuned_masses {output.tuned_masses} "
            "--tuned_history {output.tuned_history} "
            "--shamir_summary {output.shamir_summary}"
        )


# -------------------------------------------------#
# Spectrum
# -------------------------------------------------#
# 1) Plots the average plaquette for tuned Mobius
#    action as a function of the bare masses and 
#    their HMC-time evolution.
#    Plots the average plaquette for Shamir 
#    action as a function of beta and the bare
#    masses. Pure YM data and residual mass
#    data are also shown 
# 2) Plots amv as a function of amps in units
#    of w0                         
# -------------------------------------------------#

rule spectrum:
    input:
        "raw_data/NF{NF}/Nt{Nt}/Ns{Ns}/Ls{Ls}/"
        "B{beta}/M{mass}/mpv{mpv}/alpha{alpha}/a5{a5}/M5{M5}/"
        "mesons"
    output:
        data =
            "intermediary_data/NF{NF}/Nt{Nt}/Ns{Ns}/Ls{Ls}/"
            "B{beta}/M{mass}/mpv{mpv}/alpha{alpha}/a5{a5}/M5{M5}/"
            "spectrum/spectrum.json",
            
        plot_ps = multiext(
            "intermediary_data/NF{NF}/Nt{Nt}/Ns{Ns}/Ls{Ls}/"
            "B{beta}/M{mass}/mpv{mpv}/alpha{alpha}/a5{a5}/M5{M5}/"
            "spectrum/ps_plot",
            config["plot_filetype"],
        ),

        plot_v = multiext(
            "intermediary_data/NF{NF}/Nt{Nt}/Ns{Ns}/Ls{Ls}/"
            "B{beta}/M{mass}/mpv{mpv}/alpha{alpha}/a5{a5}/M5{M5}/"
            "spectrum/v_plot",
            config["plot_filetype"],
        ),

        plot_fps = multiext(
            "intermediary_data/NF{NF}/Nt{Nt}/Ns{Ns}/Ls{Ls}/"
            "B{beta}/M{mass}/mpv{mpv}/alpha{alpha}/a5{a5}/M5{M5}/"
            "spectrum/fps_plot",
            config["plot_filetype"],
        ),

        plot_Z = multiext(
            "intermediary_data/NF{NF}/Nt{Nt}/Ns{Ns}/Ls{Ls}/"
            "B{beta}/M{mass}/mpv{mpv}/alpha{alpha}/a5{a5}/M5{M5}/"
            "spectrum/Z_plot",
            config["plot_filetype"],
        )
    params:
        plateau_start_ps  = metadata_lookup("ps_p_start"),
        plateau_end_ps    = metadata_lookup("ps_p_end"),
        plateau_start_v   = metadata_lookup("v_p_start"),
        plateau_end_v     = metadata_lookup("v_p_end"),
        plateau_start_fps = metadata_lookup("fps_p_start"),
        plateau_end_fps   = metadata_lookup("fps_p_end"),
        plateau_start_Z   = metadata_lookup("Z_p_start"),
        plateau_end_Z     = metadata_lookup("Z_p_end"),
        therm             = metadata_lookup("therm"),
        delta_traj        = metadata_lookup("delta_traj_ps"),
    conda:
        "envs/analysis.yml"
    shell:
        (
            "python src/spectrum/spectrum.py {input} "
            "--label {config[label]} "
            "--spectrum_out {output.data} "
            "--plot_ps  {output.plot_ps} "
            "--plot_v   {output.plot_v} "
            "--plot_fps {output.plot_fps} "
            "--plot_Z   {output.plot_Z} "
            "--plot_styles {config[plot_styles]} "
            "--n_boot {config[bootstrap_spectrum_samples]} "
            "--plateau_start_ps {params.plateau_start_ps} "
            "--plateau_end_ps {params.plateau_end_ps} "
            "--plateau_start_v {params.plateau_start_v} "
            "--plateau_end_v {params.plateau_end_v} "
            "--plateau_start_fps {params.plateau_start_fps} "
            "--plateau_end_fps {params.plateau_end_fps} "
            "--plateau_start_Z {params.plateau_start_Z} "
            "--plateau_end_Z {params.plateau_end_Z} "
            "--therm {params.therm} "
            "--delta_traj {params.delta_traj} "
            "--beta {wildcards.beta} "
            "--mass {wildcards.mass} "
            "--Ns {wildcards.Ns}"
        )


